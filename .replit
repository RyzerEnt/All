modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/test-app: Test app"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/test-app run dev"
waitForPort = 8099

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/ryzer-site: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/ryzer-site"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/ryzer-site run dev"
cwd = "./artifacts/ryzer-site"
waitForPort = 25115
router = "path"

[workflows.workflow.tasks.env]
PORT = "25115"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/ryzer-app: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/ryzer-app"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/ryzer-app run dev"
cwd = "./artifacts/ryzer-app"
waitForPort = 22479
ensurePreviewReachable = "/status"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "22479"
BASE_PATH = "/ryzer-app/"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 22479
externalPort = 3000

[[ports]]
localPort = 22480
externalPort = 3003

[[ports]]
localPort = 22481
externalPort = 3001

[[ports]]
localPort = 25115
externalPort = 80

[userenv]

[userenv.shared]
ADMIN_EMAIL = "meonix100@gmail.com"
CLERK_PUBLISHABLE_KEY = "pk_test_c3RlYWR5LXNoZXBoZXJkLTgzLmNsZXJrLmFjY291bnRzLmRldiQ"
PORT = "8099"

[nix]
channel = "stable-25_05"
packages = ["eas-cli", "zulu23"]

[objectStorage]
defaultBucketID = "replit-objstore-3822dfee-3d27-4431-b6c5-6cf30501d18b"
