modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Site Vitrine"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "App Mobile"

[[workflows.workflow]]
name = "Site Vitrine"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/ryzer-site dev"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server dev"
waitForPort = 8099

[[workflows.workflow]]
name = "App Mobile"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/ryzer-app dev"
waitForPort = 8080

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 22479
externalPort = 3000

[[ports]]
localPort = 22480
externalPort = 3003

[[ports]]
localPort = 25115
externalPort = 80

[userenv]

[userenv.shared]
ADMIN_EMAIL = "meonix100@gmail.com"
CLERK_PUBLISHABLE_KEY = "pk_test_c3RlYWR5LXNoZXBoZXJkLTgzLmNsZXJrLmFjY291bnRzLmRldiQ"
PORT = "8099"

[nix]
channel = "stable-25_05"
packages = ["eas-cli"]

